{
  "name": "@vamos/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Supabase (Postgres) migrations and SQL access helpers for Vamos Taxi.",
  "//exports": "./verify lands in Phase 3 plan 03-04 (its only consumer is the isolation probe); ./database.types is generated by Phase 2 plan 02-09. Both are forward-declared here (D-13) — do not import either before its file lands.",
  "exports": {
    "./identity": "./src/identity.ts",
    "./public": "./src/public.ts",
    "./claims": "./src/claims.ts",
    "./verify": "./src/verify.ts",
    "./database.types": "./database.types.ts"
  },
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "test:db": "supabase test db",
    "types": "supabase gen types typescript --local --schema public > database.types.ts",
    "types:check": "supabase gen types typescript --local --schema public | diff -q - database.types.ts",
    "seed:gen": "node seed/generate-seed.mjs",
    "seed:check": "node seed/generate-seed.mjs --check",
    "push": "supabase db push --include-seed",
    "link": "supabase link --project-ref ${SUPABASE_PROJECT_ID:-yaumjzvylngfjhtuffqs}",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('@vamos/db unit')\" && vitest run test/local/identity-contract.test.ts",
    "test:local": "vitest run test/local",
    "test:deployed": "vitest run test/deployed",
    "mutation-gate": "node scripts/mutation-gate.mjs",
    "local-roles": "node scripts/local-role-passwords.mjs",
    "probe:now": "node scripts/probe-now-frozen.mjs"
  },
  "dependencies": {
    "jose": "6.2.10",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "undici": "8.10.0",
    "vitest": "4.1.11"
  }
}
