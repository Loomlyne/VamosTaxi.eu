{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "test-results/.next-dev-exclusion/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".open-next",
    ".next",
    // 26.0: test builds write to test-results/.next-*; excluded like `.next`, so a spec's
    // isolated `next build` type-checks exactly what the production build checks.
    "test-results",
    // Regenerated by `wrangler types` (gitignored, never committed — see the root
    // `.gitignore` comment). Its `NodeJS.ProcessEnv` augmentation makes `DEPLOY_ENV`
    // required for whichever `--env` it was last generated against, colliding with
    // `lib/env.d.ts`'s intentionally optional `DEPLOY_ENV` (undefined under
    // `env.production` is the whole point — see that file's comment) and with
    // `tests/integration/dev-exclusion.spec.ts`'s `delete prodEnv.DEPLOY_ENV`. This repo's
    // committed source of truth is the hand-authored `lib/env.d.ts`, not this artifact.
    "worker-configuration.d.ts"
  ]
}
