{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vamos-dashboard",
  "main": "dashboard-gateway.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  // Custom domain only. Empty zone Workers Routes stay empty.
  // Never bind vamostaxi.site or www. Never bind vamos-ops-changes.
  "routes": [
    { "pattern": "dashboard.vamostaxi.site", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "APP",
      "service": "vamos",
      "entrypoint": "Dashboard"
    },
    {
      "binding": "PUBLIC",
      "service": "vamos"
    }
  ]
}
