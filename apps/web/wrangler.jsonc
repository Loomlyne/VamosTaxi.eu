{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vamos-web",
  "main": "worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Do not 307 Name.dc.html → Name.dc. One file: Name.dc.html.
    "html_handling": "none",
    // Extensionless /app/pages/{slug} must not be served as a phantom asset.
    // Run the Worker first so those URLs 308/404.
    "run_worker_first": ["/app/pages/*", "/app/home/*", "/app/ops/*", "/dev", "/dev/*"]
  },
  "observability": {
    "enabled": true
  },

  // Top-level bindings are unused — named environments below do not inherit
  // them (wrangler warns and drops them silently otherwise), so every real
  // binding lives under env.staging / env.production, each pointed at its
  // own resource per D-34's staging/production split.

  // No `vars` block ever carries a credential — `vars` is plaintext in this
  // committed file. Every secret (Stripe, Supabase, Resend, Mapbox,
  // AeroDataBox, Turnstile, Sentry) reaches the Worker via `wrangler secret
  // put`, per PLAT-06 and threat T-01-01. Turnstile has no wrangler.jsonc
  // binding shape of its own — it is a site-key pair delivered as a secret
  // plus a public key, wired at Phase 4 planning.

  "env": {
    // Front preview Worker leftover. Never bind vamostaxi.site
    // or dashboard.vamostaxi.site. Do not deploy. No Hyperdrive.
    "front": {
      "name": "vamos-front-changes",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DEPLOY_ENV": "staging"
      }
    },
    "staging": {
      "name": "vamos",
      // Public hostname is vamostaxi.site (zone f0119383…). vamostaxi.eu
      // is abandoned — no access, never bind it. K88: workers.dev off on
      // this live Worker — custom domains only. Do not deploy env.production.
      "workers_dev": false,
      "routes": [
        { "pattern": "vamostaxi.site", "custom_domain": true },
        { "pattern": "www.vamostaxi.site", "custom_domain": true }
        // dashboard.vamostaxi.site is Worker vamos-dashboard
        // (wrangler.dashboard.jsonc). Do not bind it here. Do not bind
        // vamos-ops-changes to that hostname.
      ],
      // Plain, non-secret marker (never a credential — see the top-level
      // `vars` comment above) — apps/web/middleware.ts reads this to scope
      // the X-Robots-Tag: noindex header to staging only (D-37). Absent
      // under env.production, which is what keeps the header off production.
      //
      // PRICING_PREVIEW (D-33): staging ONLY. Every read is
      // env.PRICING_PREVIEW === "true". Lets quote/reprice resolve the newest
      // draft for display; checkout intent still refuses (rate_version_is_live
      // is trigger-derived from status, not this var).
      "vars": {
        "DEPLOY_ENV": "staging",
        // K76: this Worker is apex+www only. Host: dashboard is ignored.
        // Real dashboard TLS hits vamos-dashboard → Dashboard entrypoint.
        "VAMOS_SURFACE": "public",
        "PRICING_PREVIEW": "true",
        // D-54 / U37: engineering UNIT COUNT sentinel for the daily Mapbox
        // breaker — not a budget, not a franc figure. Trips rather than logs.
        // No Mapbox plan exists yet, so no ceiling in francs can be honest.
        "MAPBOX_DAILY_UNIT_SENTINEL": "5000",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51UIZmqHcNp9GZYjzrjt6veTXy3EkAOLiOLfYwc4rXpSxIY7HMLFViyMV7IxirWjmV1OkwVFo1Z5De2YrANVtiB5M002tCIoxfZ",
        "STRIPE_CHECKOUT_TWINT": "on"
      },
      "kv_namespaces": [
        { "binding": "GEO_CACHE", "id": "48cd800d63e44c03aa1f49be83d39d7a" },
        // D-37: dedicated namespace for quote abuse / daily breaker counters —
        // never GEO_CACHE. TTL semantics differ; mixing a daily counter with a
        // cache is how one evicts the other.
        // TODO(08-deploy): replace with the id from `wrangler kv namespace create`
        {
          "binding": "QUOTE_ABUSE",
          "id": "5080f3d518c24eaeb7b0590c922349c2"
        }
      ],
      // Workers AI: extra names are machine-translated on save (D-44).
      "ai": { "binding": "AI" },
      "r2_buckets": [
        { "binding": "PHOTOS", "bucket_name": "vamos-photos-staging" },
        { "binding": "SUPPORT_FILES", "bucket_name": "vamos-support-staging" }
      ],
      "queues": {
        "producers": [
          { "binding": "STRIPE_EVENTS", "queue": "vamos-stripe-events-staging" }
        ],
        "consumers": [
          {
            "queue": "vamos-stripe-events-staging",
            // Small batch + short timeout: a confirmation email waiting for a
            // full batch window is a customer staring at a processing page.
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            // Cover the P0002 window (intent tx committing) then exhaust rather
            // than retry forever.
            "max_retries": 8,
            // Exhausted messages must be inspectable, not silently dropped.
            "dead_letter_queue": "vamos-stripe-events-staging-dlq"
          },
          // D-06: consumer for the DLQ itself. worker.ts routes any batch.queue ending in
          // "-dlq" to lib/checkout/dlq.ts, which alerts info@ once and always acks. No
          // max_retries, no dead_letter_queue — end of the line; a DLQ message is never
          // retried into itself (T-26.1-10). Confirmed on the account read-only via
          // `wrangler queues list` 2026-09-28: this queue already exists
          // (id d9395539183a4449972c17d11f0fb7f5, created 2026-09-06), 0 consumers today.
          {
            "queue": "vamos-stripe-events-staging-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 30
          }
        ]
      },
      "triggers": {
        // Cloudflare cron has no IANA timezone. worker.ts gates the hourly trigger at exact
        // Europe/Zurich 06:00, including both sides of the DST transition.
        // First Phase 7 case on this trigger list: notification_sweep over
        // booking_notifications_pending, filtered to confirmation (D-17). Phase 9
        // extends the kind array for reminder_24h.
        "crons": ["0 * * * *", "0 3 * * *"]
      },
      // Placement Hints (D-22). Host probe (`db.<ref>:5432`) placed FRA and DATA-05
      // p50 went 34 → 47 ms. Region `aws:eu-central-2` (Zurich) is the better
      // measured number. Pins fetch handlers only (D-24).
      "placement": { "region": "aws:eu-central-2" },
      // DATA-05's instrument (D-23): every `withIdentity` call from
      // `apps/web/lib/db/identity.ts` writes one Workers Analytics Engine data point here,
      // on both the success and the error branch. The dataset exists from this plan
      // forward; the p50 percentile itself stays literally DEFERRED (`DATA-05 p50 =
      // DEFERRED (no staging Worker)`) until plan 03-07 deploys a staging Worker that has
      // actually written points — a local timing is not the criterion (D-27).
      "analytics_engine_datasets": [
        { "binding": "DB_LATENCY", "dataset": "vamos_db_latency" },
        // QUOTE-09 abuse / Mapbox trip metrics (plan 04-07 declares; 04-13 writes).
        { "binding": "QUOTE_ABUSE_METRICS", "dataset": "vamos_quote_abuse" }
      ],
      // Two rate-limit bindings, not one (D-36): the binding's limit is fixed per
      // binding. 8/60 verified-cookie bucket and 4/60 bare-IP bucket are the two
      // halves — an unverifiable cookie must fall into the SMALLER bucket, never
      // into a fresh copy of the larger one.
      "ratelimits": [
        {
          "name": "QUOTE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 8, "period": 60 }
        },
        {
          "name": "QUOTE_RATE_LIMITER_BARE",
          "namespace_id": "1002",
          "simple": { "limit": 4, "period": 60 }
        },
        // Sign-in / sign-up / e-mail-code attempts on /api/auth: 10 per 60 s per IP, its own
        // bucket so quotes and sign-in never starve each other.
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        },
        // POST /api/checkout/intent (26.5 D-20): 8 Pay presses per 60 s per IP, its own bucket so
        // price lookups never use it up.
        {
          "name": "INTENT_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 8, "period": 60 }
        },
        // Quick 261003: geo lookups (/api/geo/suggest, /retrieve, /reverse) have their
        // own counter. Sharing 1001/1002 let address typing on home spend the /api/quote
        // allowance, so /checkout refused its first price on live (2026-10-03). Home asks
        // suggest 160 ms after a keystroke (2+ characters): two addresses plus retrieves and the
        // checkout retrieve come to ~20-25 calls in a minute. Keys are per IPv4 address or IPv6
        // /64. Warning: the Mapbox breaker (MAPBOX_DAILY_UNIT_SENTINEL) is site-wide; one /64 at
        // the bare 30/min trips it in ~170 min and then the whole site stops pricing until
        // midnight UTC. Sizing in lib/abuse/guards.ts `RateCounter`.
        {
          "name": "LOOKUP_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "LOOKUP_RATE_LIMITER_BARE",
          "namespace_id": "1006",
          "simple": { "limit": 30, "period": 60 }
        },
        // Quick 261003: /api/quote/reprice and the voucher check in /api/checkout/price. No
        // Directions call; the limit guards voucher guessing. One booking spends 1-4.
        {
          "name": "PRICE_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "PRICE_RATE_LIMITER_BARE",
          "namespace_id": "1008",
          "simple": { "limit": 8, "period": 60 }
        },
        // Quick 261003 review: /api/flight/:no has its own small counter. AeroDataBox bills
        // every call and a not_found answer is never cached; one flight number costs 1-3 calls.
        {
          "name": "FLIGHT_RATE_LIMITER",
          "namespace_id": "1009",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "FLIGHT_RATE_LIMITER_BARE",
          "namespace_id": "1010",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      // Rule 2 addition (plan 03-06, D-36): uncommented from the placeholder block plan
      // 03-03 left here — D-36 requires the OpenNext runtime path smoke-tested through a
      // real `opennextjs-cloudflare preview --env staging` (never `--env production`: the
      // `/api/dev/db-smoke` route's own `DEPLOY_ENV === "staging"` gate 404s any other
      // environment, per its own header comment), and `preview`/`wrangler dev` never
      // reached the platform proxy at all while this binding was fully commented out.
      // Confirmed empirically this session that `wrangler dev`'s LOCAL mode uses only
      // `localConnectionString` and never validates `id` as a real UUID (that validation
      // is `wrangler deploy`-only, per the `id` placeholder's own original comment,
      // preserved on the `id` lines below) — so this is safe to enable now without
      // `wrangler hyperdrive create` or any owner-held credential (D-29). Plan 03-07
      // (2026-08-25) filled both ids with real Hyperdrive configs against
      // `yaumjzvylngfjhtuffqs`'s direct connection string — origin-connection-limit
      // 20/12, D-43-derived from measured `max_connections=60` (see
      // docs/build/CLOUDFLARE-RESOURCES.md § "D-43 (U32)"), not the research's 25/15.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "b53693800b7e4c1c94205774baa73420",
          "localConnectionString": "postgres://vamos_public:***@127.0.0.1:54322/postgres"
        },
        {
          "binding": "HYPERDRIVE_NOCACHE",
          "id": "71523abbbb7542fdbff01f66d9a858ed",
          "localConnectionString": "postgres://vamos_edge:***@127.0.0.1:54322/postgres"
        }
      ],
      // D-13: without this binding `/_next/image` answers 200 with the original,
      // unresized file (Phase 1 finding). Named envs do not inherit top-level
      // bindings — declare IMAGES here and under env.production.
      "images": { "binding": "IMAGES" },
      // Auth transactional mail (magic / confirm / reset). Domain onboarded
      // 2026-08-31 via `wrangler email sending enable vamostaxi.site`.
      "send_email": [{ "name": "EMAIL" }]
    },
    // Isolated ops-preview leftover. Never bind hostnames. Never deploy
    // onto vamos. No Hyperdrive/KV/R2.
    "ops-changes": {
      "name": "vamos-ops-changes",
      "workers_dev": false,
      "vars": {
        "DEPLOY_ENV": "ops-changes"
      }
    },
    "production": {
      "name": "vamos-web-production",
      // Not deployed. Public traffic is vamostaxi.site on
      // vamos. vamostaxi.eu is abandoned — no zone, no bind.
      // No PRICING_PREVIEW assignment here (D-33). Its ABSENCE is the control.
      // Setting that var to the string false under production would be a bug,
      // not belt-and-braces — every read is === "true", so a missing binding
      // is already falsy.
      "vars": {
        // D-54 / U37: engineering UNIT COUNT sentinel — same shape as staging.
        // Not a budget; not a franc figure.
        "MAPBOX_DAILY_UNIT_SENTINEL": "5000",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_placeholder",
        "STRIPE_CHECKOUT_TWINT": "on"
      },
      "kv_namespaces": [
        { "binding": "GEO_CACHE", "id": "a11bc8c7d13d4eeb9c2dad091e978dcb" },
        // D-37: dedicated QUOTE_ABUSE namespace — never GEO_CACHE.
        // TODO(08-deploy): replace with the id from `wrangler kv namespace create`
        {
          "binding": "QUOTE_ABUSE",
          "id": "<quote-abuse production kv id — created by plan 04-13 via wrangler kv namespace create>"
        }
      ],
      // Workers AI: extra names are machine-translated on save (D-44).
      "ai": { "binding": "AI" },
      "r2_buckets": [
        { "binding": "PHOTOS", "bucket_name": "vamos-photos-production" }
      ],
      "queues": {
        "producers": [
          { "binding": "STRIPE_EVENTS", "queue": "vamos-stripe-events-production" }
        ],
        "consumers": [
          {
            "queue": "vamos-stripe-events-production",
            // Small batch + short timeout: a confirmation email waiting for a
            // full batch window is a customer staring at a processing page.
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            // Cover the P0002 window (intent tx committing) then exhaust rather
            // than retry forever.
            "max_retries": 8,
            // Exhausted messages must be inspectable, not silently dropped.
            "dead_letter_queue": "vamos-stripe-events-production-dlq"
          },
          // D-06: consumer for the DLQ itself — same shape as env.staging above. Not created
          // on the account yet (`wrangler queues list` 2026-09-28 shows only the staging DLQ,
          // id d9395539183a4449972c17d11f0fb7f5); production is not deployed until Phase 11
          // (D-33), so this queue does not need to exist before then.
          {
            "queue": "vamos-stripe-events-production-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 30
          }
        ]
      },
      "triggers": {
        // Cloudflare cron has no IANA timezone. worker.ts gates the hourly trigger at exact
        // Europe/Zurich 06:00, including both sides of the DST transition.
        // First Phase 7 case on this trigger list: notification_sweep over
        // booking_notifications_pending, filtered to confirmation (D-17). Phase 9
        // extends the kind array for reminder_24h.
        "crons": ["0 * * * *", "0 3 * * *"]
      },
      // Placement Hints (D-22), not Smart Placement — see env.staging's comment above for
      // the full reasoning; identical here. The region below is Zurich (D-25),
      // superseding `03-RESEARCH.md`'s stale Frankfurt-region hint. Pins fetch handlers
      // only (D-24) — the Queues/Cron blocks above are unplaced.
      "placement": { "region": "aws:eu-central-2" },
      // DATA-05's instrument (D-23) — see env.staging's comment above. The p50 stays
      // DEFERRED until plan 03-07 measures it from a deployed staging Worker; production
      // is not the measurement environment (not deployed until Phase 11 per D-33 above).
      "analytics_engine_datasets": [
        { "binding": "DB_LATENCY", "dataset": "vamos_db_latency" },
        { "binding": "QUOTE_ABUSE_METRICS", "dataset": "vamos_quote_abuse" }
      ],
      // D-36: two rate-limit bindings — 8/60 verified cookie, 4/60 bare IP.
      "ratelimits": [
        {
          "name": "QUOTE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 8, "period": 60 }
        },
        {
          "name": "QUOTE_RATE_LIMITER_BARE",
          "namespace_id": "1002",
          "simple": { "limit": 4, "period": 60 }
        },
        // Sign-in / sign-up / e-mail-code attempts on /api/auth: 10 per 60 s per IP, its own
        // bucket so quotes and sign-in never starve each other.
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        },
        // POST /api/checkout/intent (26.5 D-20): 8 Pay presses per 60 s per IP, its own bucket so
        // price lookups never use it up.
        {
          "name": "INTENT_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 8, "period": 60 }
        },
        // Quick 261003: geo lookups (/api/geo/suggest, /retrieve, /reverse) have their
        // own counter. Sharing 1001/1002 let address typing on home spend the /api/quote
        // allowance, so /checkout refused its first price on live (2026-10-03). Home asks
        // suggest 160 ms after a keystroke (2+ characters): two addresses plus retrieves and the
        // checkout retrieve come to ~20-25 calls in a minute. Keys are per IPv4 address or IPv6
        // /64. Warning: the Mapbox breaker (MAPBOX_DAILY_UNIT_SENTINEL) is site-wide; one /64 at
        // the bare 30/min trips it in ~170 min and then the whole site stops pricing until
        // midnight UTC. Sizing in lib/abuse/guards.ts `RateCounter`.
        {
          "name": "LOOKUP_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "LOOKUP_RATE_LIMITER_BARE",
          "namespace_id": "1006",
          "simple": { "limit": 30, "period": 60 }
        },
        // Quick 261003: /api/quote/reprice and the voucher check in /api/checkout/price. No
        // Directions call; the limit guards voucher guessing. One booking spends 1-4.
        {
          "name": "PRICE_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          "name": "PRICE_RATE_LIMITER_BARE",
          "namespace_id": "1008",
          "simple": { "limit": 8, "period": 60 }
        },
        // Quick 261003 review: /api/flight/:no has its own small counter. AeroDataBox bills
        // every call and a not_found answer is never cached; one flight number costs 1-3 calls.
        {
          "name": "FLIGHT_RATE_LIMITER",
          "namespace_id": "1009",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "FLIGHT_RATE_LIMITER_BARE",
          "namespace_id": "1010",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      // Two Hyperdrive configs (D-01/D-03), never one: `HYPERDRIVE` is the cacheable,
      // public-content path (`vamos_public`); `HYPERDRIVE_NOCACHE` is cache-disabled for
      // anything carrying identity, auth, permissions or the `pricing_live` flag
      // (`vamos_edge`). Both point at Supabase's DIRECT connection string on port 5432 —
      // never Supavisor's pooled port (D-02); Hyperdrive *is* the pooler, and
      // double-pooling only surfaces under real concurrency. The credential for each
      // config lives inside the Hyperdrive config object addressed by the opaque `id`
      // below — never in this file, never `wrangler secret put` (D-01).
      //
      // Deliberately still placeholders (plan 03-07, 2026-08-25): `env.staging`'s
      // twin bindings above ARE real (ids `71523abbbb7542fdbff01f66d9a858ed` /
      // `b53693800b7e4c1c94205774baa73420`, origin-connection-limit 20/12, D-43-derived).
      // `env.production` stays a placeholder on purpose — production is not deployed
      // until Phase 11 (D-33), and creating two more Hyperdrive configs now would draw
      // two more idle origin-connection slots against the same `max_connections=60`
      // ceiling D-43 just measured (staging's own 37-connection budget already leaves
      // only 10 of headroom — see docs/build/CLOUDFLARE-RESOURCES.md § "D-43 (U32)").
      // Phase 11 creates these for real, sized against whatever headroom exists then.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "<public/cacheable config id — created by plan 03-07 via `wrangler hyperdrive create`, points at Supabase's direct connection string as vamos_public, never the pooled 6543 Supavisor string>",
          // Not a secret — a placeholder pointing at local Supabase (D-04): port 54322,
          // not 5432, logging in as `vamos_public` — not the pre-roles `postgres`
          // superuser this string replaces, which carried BYPASSRLS and made the `42501`
          // fail-closed boundary untestable. Required so `wrangler dev`/`preview` can
          // boot the platform proxy locally before any code queries this binding.
          "localConnectionString": "postgres://vamos_public:***@127.0.0.1:54322/postgres"
        },
        {
          "binding": "HYPERDRIVE_NOCACHE",
          "id": "<cache-disabled config id — created by plan 03-07 via `wrangler hyperdrive create --caching-disabled`, points at Supabase's direct connection string as vamos_edge, never the pooled 6543 Supavisor string>",
          // Local Supabase, port 54322, `vamos_edge` — same reasoning as the sibling
          // entry's comment above, different login role.
          "localConnectionString": "postgres://vamos_edge:***@127.0.0.1:54322/postgres"
        }
      ],
      // D-13: without this binding `/_next/image` answers 200 with the original,
      // unresized file (Phase 1 finding). Named envs do not inherit top-level
      // bindings — declare IMAGES here and under env.staging.
      "images": { "binding": "IMAGES" }
    }
  }
}
