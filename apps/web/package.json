{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "predev": "node ../../scripts/sync-dc-mock-to-public.mjs",
    "prebuild": "node ../../scripts/sync-dc-mock-to-public.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/sync-dc-mock-to-public.mjs && vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore --ignore-path .stylelintignore",
    "preview": "node ../../scripts/sync-dc-mock-to-public.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node ../../scripts/sync-dc-mock-to-public.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dashboard": "wrangler deploy -c wrangler.dashboard.jsonc"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "6.9.0",
    "@stripe/stripe-js": "9.15.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vamos/db": "workspace:*",
    "@vamos/emails": "workspace:*",
    "lenis": "1.3.26",
    "next": "15.5.25",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.24.0",
    "standardwebhooks": "1.0.0",
    "stripe": "22.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "fast-check": "4.9.0",
    "postgres": "3.4.9",
    "stylelint": "17.14.1",
    "stylelint-use-logical": "2.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
