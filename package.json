{
  "name": "vamos-taxi",
  "private": true,
  "version": "0.0.0",
  "description": "Vamos Taxi V1 — Next.js on Cloudflare Workers monorepo",
  "scripts": {
    "dev": "pnpm --filter web run dev",
    "build": "pnpm --filter web run build",
    "preview": "pnpm --filter web run preview",
    "deploy": "pnpm --filter web run deploy",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:css": "pnpm --filter web run lint:css",
    "i18n:check": "node scripts/check-i18n-coverage.mjs",
    "i18n:pull": "node scripts/pull-content-strings.mjs",
    "check:legal-claims": "node scripts/check-legal-language-claims.mjs",
    "check:numbers": "node scripts/check-no-invented-numbers.mjs",
    "test:unit": "pnpm test:scripts && pnpm -r --if-present run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:visual": "node scripts/sync-dc-mock-to-public.mjs && pnpm --filter web exec playwright test",
    "check:public-env": "node scripts/check-next-public-allowlist.mjs",
    "check:db-fences": "node scripts/check-db-access-fences.mjs",
    "db:start": "pnpm --filter @vamos/db run start",
    "db:stop": "pnpm --filter @vamos/db run stop",
    "db:reset": "pnpm --filter @vamos/db run reset",
    "db:test": "pnpm --filter @vamos/db run test:db",
    "db:types": "pnpm --filter @vamos/db run types",
    "db:types:check": "pnpm --filter @vamos/db run types:check",
    "db:seed:gen": "pnpm --filter @vamos/db run seed:gen",
    "db:seed:check": "pnpm --filter @vamos/db run seed:check",
    "db:push": "pnpm --filter @vamos/db run push",
    "db:link": "pnpm --filter @vamos/db run link",
    "db:local-roles": "pnpm --filter @vamos/db run local-roles",
    "db:test:local": "pnpm --filter @vamos/db run test:local",
    "db:mutation-gate": "pnpm --filter @vamos/db run mutation-gate",
    "db:probe:now": "pnpm --filter @vamos/db run probe:now"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "eslint": "10.9.1",
    "supabase": "2.115.0",
    "typescript-eslint": "8.68.0"
  }
}
