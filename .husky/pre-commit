#!/usr/bin/env sh
# Pre-commit secret scan (D-35). Wired to run via `git config core.hooksPath .husky`
# (see docs/build/GSD-LAUNCH.md § Secrets) since no `husky` npm package is installed —
# this is a plain POSIX hook, not the husky-managed dispatcher format.
#
# A scanner that no-ops when the binary is missing is worse than no scanner: fail
# loudly with install instructions rather than silently letting the commit through.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "BLOCKED: gitleaks is not installed — the pre-commit secret scan cannot run."
  echo "Install it before committing:"
  echo "  brew install gitleaks"
  echo "See https://github.com/gitleaks/gitleaks#installing for other platforms."
  echo ""
  exit 1
fi

gitleaks protect --staged --config .gitleaks.toml --redact --verbose
